# BATOPS — variables d'environnement
# Toutes sont OPTIONNELLES : sans elles, l'application fonctionne entièrement en mode démo gratuit
# (store local + MockProviders). Copier ce fichier en .env.local uniquement lors du branchement
# des vrais services, après validation commerciale.

# --- Données (Supabase, plan gratuit) — non branché au Sprint 0 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (LiveAIProvider Gemini) — non branché ---
GEMINI_API_KEY=

# --- E-mails / SMS (LiveNotificationProvider) — non branché ---
RESEND_API_KEY=
BREVO_API_KEY=

# --- Téléphonie Nora V2 (LiveVoiceProvider) — non branché ---
VAPI_API_KEY=
TWILIO_AUTH_TOKEN=

# Ne jamais préfixer une clé secrète par NEXT_PUBLIC_.
